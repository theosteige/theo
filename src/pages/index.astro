---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pathWithBase } from "../lib/site";

const pages = [
  {
    title: "5-Minute Intro",
    description: "A short introduction to who I am outside of work.",
    href: pathWithBase("five-minute-intro/")
  },
  {
    title: "Mental Math",
    description: "game to improve and test my mental math abilities.",
    href: pathWithBase("mental-math/")
  },
  {
    title: "Experience",
    description: "Roles, education, collaborations, and relevant background.",
    href: pathWithBase("experience/")
  },
  {
    title: "Projects",
    description: "Current and past work.",
    href: pathWithBase("projects/")
  },
  {
    title: "Reading",
    description: "Books, papers, articles, and references.",
    href: pathWithBase("reading/")
  },
  {
    title: "Design",
    description: "A collection of images, videos, and audio.",
    href: pathWithBase("design/")
  }
];
---

<BaseLayout title="Table of Contents" description="Explore Theo Steiger's website.">
  <section class="intro" aria-labelledby="contents-title">
    <h1 id="contents-title">Table of Contents</h1>
    <p>Everything currently on this site</p>
  </section>

  <ul class="contents-list">
    {
      pages.map((page) => (
        <li>
          <div class="contents-entry">
            <h2><a href={page.href}>{page.title}</a></h2>
            <p>{page.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</BaseLayout>
