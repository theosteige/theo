---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pathWithBase } from "../lib/site";
---

<BaseLayout title="Mood" description="A collection of media." fillViewport>
    <style>
      #media {
        position: absolute;
        inset: 0;
        background: #000;
      }

      #media button {
        position: absolute;
        top: var(--y);
        left: var(--x);
        width: var(--width);
        min-width: 0;
        height: var(--height);
        padding: 0;
        border: 0;
        overflow: hidden;
        background: #000;
        color: #fff;
        cursor: pointer;
      }

      #media img,
      #media video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      #media button[data-kind="audio"] {
        display: grid;
        place-items: center;
      }

      #media audio { width: min(600px, 90%); }

      dialog {
        width: 100vw;
        max-width: none;
        height: 100vh;
        height: 100dvh;
        max-height: none;
        margin: 0;
        padding: 0;
        border: 0;
        overflow: hidden;
        background: #000;
        color: #fff;
      }

      dialog::backdrop { background: #000; }

      #viewer {
        display: grid;
        width: 100%;
        height: 100%;
        place-items: center;
      }

      #viewer img,
      #viewer video,
      #viewer iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        object-fit: contain;
      }

      #viewer audio { width: min(600px, 90vw); }

      #close {
        position: fixed;
        z-index: 1;
        top: 0;
        right: 0;
        width: 48px;
        height: 48px;
        border: 0;
        background: #000;
        color: #fff;
        font: 32px/1 sans-serif;
        cursor: pointer;
      }
    </style>

    <!--
      Add, remove, or copy the button blocks inside #media.
      data-kind may be image, video, audio, or file.
      data-src is the full-size file opened in the viewer.
    -->
    <section id="media" aria-label="Mood">
      <button
        type="button"
        data-kind="audio"
        data-loop
        data-src={pathWithBase("audio/mood/fakemink-crush-prod-ok_5fvYtsp6.mp3")}
        aria-label="Open looping audio player"
      >
        <audio controls loop preload="metadata" tabindex="-1" aria-hidden="true">
          <source
            src={pathWithBase("audio/mood/fakemink-crush-prod-ok_5fvYtsp6.mp3")}
            type="audio/mpeg"
          />
        </audio>
      </button>
      <button
        type="button"
        data-kind="video"
        data-src={pathWithBase("videos/mood/cannes-oxygen-tanks.mp4")}
        aria-label="Open Cannes film video"
      >
        <video autoplay muted loop playsinline preload="metadata">
          <source src={pathWithBase("videos/mood/cannes-oxygen-tanks.mp4")} type="video/mp4" />
        </video>
      </button>
      <button
        type="button"
        data-kind="video"
        data-src={pathWithBase("videos/mood/james-murphy-interview.mp4")}
        aria-label="Open James Murphy interview video"
      >
        <video autoplay muted loop playsinline preload="metadata">
          <source src={pathWithBase("videos/mood/james-murphy-interview.mp4")} type="video/mp4" />
        </video>
      </button>
      <button
        type="button"
        data-kind="video"
        data-src={pathWithBase("videos/mood/shibuya-halloween.mp4")}
        aria-label="Open Shibuya Halloween short film"
      >
        <video autoplay muted loop playsinline preload="metadata">
          <source src={pathWithBase("videos/mood/shibuya-halloween.mp4")} type="video/mp4" />
        </video>
      </button>
      <button
        type="button"
        data-kind="video"
        data-src={pathWithBase("videos/mood/travis-virgil-kanye.mp4")}
        aria-label="Open Travis Scott, Virgil Abloh, and Kanye West video"
      >
        <video autoplay muted loop playsinline preload="metadata">
          <source src={pathWithBase("videos/mood/travis-virgil-kanye.mp4")} type="video/mp4" />
        </video>
      </button>
      <button
        type="button"
        data-kind="video"
        data-src={pathWithBase("videos/mood/parts-where-wholes.mp4")}
        aria-label="Open Parts Where Wholes Are Described As Such video"
      >
        <video autoplay muted loop playsinline preload="metadata">
          <source src={pathWithBase("videos/mood/parts-where-wholes.mp4")} type="video/mp4" />
        </video>
      </button>
      <button
        type="button"
        data-kind="video"
        data-src={pathWithBase("videos/mood/infohazard.mp4")}
        aria-label="Open infohazard video"
      >
        <video autoplay muted loop playsinline preload="metadata">
          <source src={pathWithBase("videos/mood/infohazard.mp4")} type="video/mp4" />
        </video>
      </button>
      <button
        type="button"
        data-kind="image"
        data-src={pathWithBase("images/mood/emirshiro-collage-4.jpg")}
        aria-label="Open fish and eye collage"
      >
        <img
          src={pathWithBase("images/mood/emirshiro-collage-4.jpg")}
          alt="Surreal collage of an eye and a goldfish"
        />
      </button>
      <button
        type="button"
        data-kind="image"
        data-src={pathWithBase("images/mood/emirshiro-collage-3.jpg")}
        aria-label="Open skin and galaxy collage"
      >
        <img
          src={pathWithBase("images/mood/emirshiro-collage-3.jpg")}
          alt="Surreal collage pairing skin with a galaxy"
        />
      </button>
      <button
        type="button"
        data-kind="image"
        data-src={pathWithBase("images/mood/emirshiro-collage-2.jpg")}
        aria-label="Open giraffe and hand collage"
      >
        <img
          src={pathWithBase("images/mood/emirshiro-collage-2.jpg")}
          alt="Surreal collage of a giraffe and a hand"
        />
      </button>
      <button
        type="button"
        data-kind="image"
        data-src={pathWithBase("images/mood/emirshiro-collage-1.jpg")}
        aria-label="Open fish and kiss collage"
      >
        <img
          src={pathWithBase("images/mood/emirshiro-collage-1.jpg")}
          alt="Surreal collage of a red fish and two people kissing"
        />
      </button>
    </section>

    <dialog id="dialog" aria-label="Media viewer">
      <button id="close" type="button" aria-label="Close viewer">&times;</button>
      <div id="viewer"></div>
    </dialog>

    <script is:inline>
      const mediaGrid = document.querySelector("#media");
      const dialog = document.querySelector("#dialog");
      const viewer = document.querySelector("#viewer");
      const close = document.querySelector("#close");

      const buildMediaLayout = (itemCount) => {
        if (itemCount === 0) return [];

        const tiles = [
          { index: 0, depth: 0, x: 0, y: 0, width: 1, height: 1 }
        ];

        for (let index = 1; index < itemCount; index += 1) {
          let tileToSplit = tiles[0];

          for (const tile of tiles) {
            const isLarger = tile.depth < tileToSplit.depth;
            const isOlderAtSameSize =
              tile.depth === tileToSplit.depth && tile.index < tileToSplit.index;

            if (isLarger || isOlderAtSameSize) tileToSplit = tile;
          }

          const splitVertically = tileToSplit.depth % 2 === 0;
          const nextDepth = tileToSplit.depth + 1;
          const newTile = {
            index,
            depth: nextDepth,
            x: tileToSplit.x,
            y: tileToSplit.y,
            width: tileToSplit.width,
            height: tileToSplit.height
          };

          if (splitVertically) {
            const halfWidth = tileToSplit.width / 2;
            tileToSplit.width = halfWidth;
            newTile.x += halfWidth;
            newTile.width = halfWidth;
          } else {
            const halfHeight = tileToSplit.height / 2;
            tileToSplit.height = halfHeight;
            newTile.y += halfHeight;
            newTile.height = halfHeight;
          }

          tileToSplit.depth = nextDepth;
          tiles.push(newTile);
        }

        return tiles;
      };

      const updateLayout = () => {
        const items = [...mediaGrid.children];
        const tiles = buildMediaLayout(items.length);

        for (const tile of tiles) {
          const item = items[tile.index];
          item.style.setProperty("--x", `${tile.x * 100}%`);
          item.style.setProperty("--y", `${tile.y * 100}%`);
          item.style.setProperty("--width", `${tile.width * 100}%`);
          item.style.setProperty("--height", `${tile.height * 100}%`);
        }
      };

      updateLayout();
      new MutationObserver(updateLayout).observe(mediaGrid, { childList: true });

      mediaGrid.addEventListener("click", (event) => {
        const item = event.target.closest("button[data-kind]");
        if (!item) return;

        if (event.target.closest("audio")) event.preventDefault();
        const previewAudio = item.querySelector("audio");
        if (previewAudio) {
          previewAudio.pause();
          previewAudio.currentTime = 0;
        }

        const kind = item.dataset.kind;
        const src = item.dataset.src;
        let media;

        if (kind === "image") {
          media = new Image();
          media.alt = item.querySelector("img")?.alt ?? "";
        } else if (kind === "video") {
          media = document.createElement("video");
          media.controls = true;
          media.autoplay = true;
          media.playsInline = true;
        } else if (kind === "audio") {
          media = document.createElement("audio");
          media.controls = true;
          media.autoplay = true;
          media.loop = item.hasAttribute("data-loop");
        } else {
          media = document.createElement("iframe");
          media.title = "File viewer";
        }

        media.src = src;
        viewer.replaceChildren(media);
        dialog.showModal();
      });

      close.addEventListener("click", () => dialog.close());
      dialog.addEventListener("close", () => viewer.replaceChildren());

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && dialog.open) dialog.close();
      });
    </script>
</BaseLayout>
